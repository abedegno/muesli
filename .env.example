# Full variable reference: docs/CONFIGURATION.md
#
# Muesli environment overrides.
#
# Copy to `.env` (`cp .env.example .env`) to override the compose defaults.
# `docker compose up` works with NO .env at all — every var below has a built-in
# dev fallback in docker-compose.yml.
#
# =====================================================================
#  !! THE BUILT-IN DEFAULTS ARE DEV ONLY — SET REAL SECRETS FOR PROD !!
# =====================================================================

# Server listen address (host:port). Default: :8080 (all interfaces, port 8080).
# Prod note: rarely needs changing — put a reverse proxy (nginx/caddy) in front
# instead. Only set this if you need the server to bind a different port or
# interface (e.g. 127.0.0.1:9000 to bind loopback only).
#MUESLI_ADDR=:8080

# Postgres superuser password. Used by both the postgres service and the
# server's DATABASE_URL.
POSTGRES_PASSWORD=postgres

# Master key (base64, exactly 32 bytes) used to encrypt plugin secrets at rest.
# REQUIRED for the server to start. Generate a real one with:
#   openssl rand -base64 32
# The compose default is a throwaway dev key — DO NOT use it in production.
MUESLI_MASTER_KEY=

# Signing key for presigned upload/download URLs. Must be stable across restarts
# and replicas (else previously issued URLs stop verifying). At least 16 bytes.
# Generate with: openssl rand -base64 32
MUESLI_STORAGE_SIGNING_KEY=

# Shared bearer tokens between the server and each plugin. The server sends these
# as `Authorization: Bearer <token>`; each plugin checks against its
# MUESLI_PLUGIN_TOKEN. Compose wires the same value to both sides automatically.
WHISPER_TOKEN=dev-whisper-token
AGENT_TOKEN=dev-agent-token

# Base URL the server advertises to clients / the desktop app in signed UPLOAD
# URLs. Set to your public hostname in production (e.g. https://muesli.example.com).
# NOTE: the plugin-facing internal URL is fixed to http://server:8080 in compose
# and does not need overriding.
MUESLI_PUBLIC_URL=http://localhost:8080

# Semantic search: self-hosted embeddings via Ollama. Compose defaults to the bundled
# ollama service; the ollama-pull-embed one-shot pulls the model. Leave
# MUESLI_EMBEDDINGS_URL empty to DISABLE semantic search (search stays lexical-only).
MUESLI_EMBEDDINGS_URL=http://ollama:11434
# MUESLI_EMBEDDINGS_MODEL may be any Ollama embedding model — the dimension is
# handled automatically (the vector column is unsized), so no migration is needed
# to switch. Candidates: nomic-embed-text (768), embeddinggemma:300m (768),
# qwen3-embedding (1024), bge-m3 (1024). Each may want its own task prefixes
# (MUESLI_EMBEDDINGS_DOC_PREFIX / _QUERY_PREFIX) and min-score below. After changing
# the model (or prefixes), restart (the startup backfill re-embeds notes lacking a
# current-model embedding) or run `muesli reembed` to force a full re-embed.
MUESLI_EMBEDDINGS_MODEL=nomic-embed-text
# Cosine similarity cutoff for a semantic search hit (0–1). Higher = stricter
# (fewer, more-relevant results); lower = looser. 0.6 suits prefixed nomic-embed-text.
MUESLI_EMBEDDINGS_MIN_SCORE=0.6
# Task prefix prepended to stored note text before embedding (for asymmetric models).
# Default matches nomic-embed-text. Change when switching model family — e.g.
# "passage: " for e5 models, or empty string for symmetric/prefix-less models.
# After changing, run `muesli reembed` to rebuild the entire index.
# Prod note: keep DOC_PREFIX and QUERY_PREFIX in sync for the same model family.
MUESLI_EMBEDDINGS_DOC_PREFIX=search_document: 
# Task prefix prepended to search queries. Default matches nomic-embed-text.
# Prod note: keep in sync with MUESLI_EMBEDDINGS_DOC_PREFIX for the same model family.
MUESLI_EMBEDDINGS_QUERY_PREFIX=search_query: 
# Number of notes to backfill embeddings for on startup (default 500).
MUESLI_EMBED_BACKFILL_BATCH_SIZE=500

# How many days trashed notes/folders/smart-lists are kept before permanent purge.
# Must be a positive integer. Invalid or missing values default to 30.
MUESLI_TRASH_RETENTION_DAYS=30

# Audio lifecycle: what happens to uploaded audio after transcription completes.
# Values: "keep" (default) — audio is retained in MUESLI_STORAGE_DIR;
#         "discard" — audio file is deleted immediately after transcription,
#                     minimising on-disk data retention.
# Prod note: set to "discard" if you do not need to replay or reprocess audio.
#MUESLI_AUDIO_RETENTION=keep

# ── Plugin auto-registration ───────────────────────────────────────────────────
# The six MUESLI_DEFAULT_* vars let the server auto-register its default
# transcriber and agent plugins on startup, removing the manual admin-UI step.
# A plugin kind is only registered when BOTH its URL and TOKEN are set.
# In docker-compose these are wired automatically from the service network and
# the WHISPER_TOKEN / AGENT_TOKEN values above; set them here for bare-metal /
# non-compose deployments.

# HTTP URL of the default transcriber plugin. In compose this is hardcoded to
# http://whisper:8000. Leave empty (or unset) to skip auto-registration and
# register the transcriber manually via the admin UI.
# Default: empty (unset). Prod note: set to your whisper service URL when
# deploying outside docker-compose (e.g. http://whisper.internal:8000).
#MUESLI_DEFAULT_TRANSCRIBER_URL=

# Bearer token the server sends to the transcriber plugin. Must match the plugin's
# own MUESLI_PLUGIN_TOKEN. In compose this is wired from WHISPER_TOKEN above.
# Default: empty (unset). Prod note: use a strong random secret; keep it in sync
# with the MUESLI_PLUGIN_TOKEN set on your whisper service.
#MUESLI_DEFAULT_TRANSCRIBER_TOKEN=

# JSON config forwarded to the transcriber on registration. Default: {}.
# Example for whisper: {"model":"base"}
# Prod note: use {} unless your transcriber plugin requires extra parameters.
#MUESLI_DEFAULT_TRANSCRIBER_CONFIG={}

# HTTP URL of the default agent plugin. In compose this is hardcoded to
# http://agent:8000. Leave empty (or unset) to skip auto-registration.
# Default: empty (unset). Prod note: set to your ollama-agent service URL when
# deploying outside docker-compose (e.g. http://agent.internal:8000).
#MUESLI_DEFAULT_AGENT_URL=

# Bearer token the server sends to the agent plugin. Must match the plugin's
# own MUESLI_PLUGIN_TOKEN. In compose this is wired from AGENT_TOKEN above.
# Default: empty (unset). Prod note: use a strong random secret; keep it in sync
# with the MUESLI_PLUGIN_TOKEN set on your agent service.
#MUESLI_DEFAULT_AGENT_TOKEN=

# JSON config forwarded to the agent on registration. Default: {}.
# Example: {"ollama_url":"http://ollama:11434","model":"llama3.2:3b"}
# Prod note: set ollama_url and model to match your self-hosted Ollama service.
#MUESLI_DEFAULT_AGENT_CONFIG={}
# Token-bucket rate limiting for sensitive endpoints.
# Values of 0 disable rate limiting on that endpoint.
# Login endpoint (POST /api/login): default 5 requests/minute, burst 3.
MUESLI_RATE_LOGIN_RPS=0.0833
MUESLI_RATE_LOGIN_BURST=3
# Presigned upload-URL endpoint (POST /api/notes/{id}/audio-upload-url): default 20 req/min, burst 5.
MUESLI_RATE_UPLOAD_RPS=0.333
MUESLI_RATE_UPLOAD_BURST=5
# CORS: comma-separated list of allowed cross-origin request origins.
# Empty (default) = no cross-origin access. The Electron desktop client
# does not need this. Set it when running a web app against the API:
#   MUESLI_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
# MUESLI_ALLOWED_ORIGINS=

# Audio Content-Type allowlist enforced on the upload PUT path
# (/_storage/<key>). Comma-separated; unset/empty uses the built-in default
# covering audio/mpeg, audio/mp4 (+ m4a variants), audio/wav (+ variants),
# audio/ogg (+ opus), audio/webm (the desktop client's recorder mimeType),
# and audio/flac variants. Override only if you need to accept an additional
# audio format.
#   MUESLI_UPLOAD_ALLOWED_CONTENT_TYPES=audio/webm,audio/mpeg,audio/wav
# MUESLI_UPLOAD_ALLOWED_CONTENT_TYPES=
